<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="500" prefWidth="400" spacing="0" style="-fx-background-color: #1a1a2e;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="org.club.MainController">

    <VBox alignment="CENTER" spacing="8" VBox.vgrow="ALWAYS">
        <padding><Insets bottom="20" top="60" /></padding>

        <Label style="-fx-font-size: 48px;" text="🎬" />
        <Label style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: white;" text="Club de Películas" />
        <Label style="-fx-font-size: 13px; -fx-text-fill: #8888aa;" text="Tu colección personal" />
    </VBox>

    <VBox alignment="CENTER" spacing="12">
        <padding><Insets bottom="60" left="60" right="60" /></padding>

        <Button maxWidth="Infinity" onAction="#onAnadir" style="-fx-background-color: #534AB7; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 10; -fx-padding: 14 20; -fx-cursor: cursor;" text="➕  Añadir Película / Serie" />

        <Button maxWidth="Infinity" onAction="#onListar" style="-fx-background-color: #0F6E56; -fx-text-fill: white;                        -fx-font-size: 14px; -fx-font-weight: bold;                        -fx-background-radius: 10; -fx-padding: 14 20;                        -fx-cursor: hand;" text="🎞  Listar Películas / Series" />

				<Button maxWidth="Infinity" onAction="#onEliminar" style="-fx-background-color: #993C1D; -fx-text-fill: white;                -fx-font-size: 14px; -fx-font-weight: bold;                -fx-background-radius: 10; -fx-padding: 14 20;                -fx-cursor: hand;" text="🗑  Eliminar Película / Serie" />

        <Button maxWidth="Infinity" onAction="#onSalir" style="-fx-background-color: transparent; -fx-text-fill: #8888aa;                        -fx-font-size: 13px; -fx-border-color: #333355;                        -fx-border-radius: 10; -fx-background-radius: 10;                        -fx-padding: 10 20; -fx-cursor: hand;" text="✕  Salir" />

    </VBox>
</VBox>
