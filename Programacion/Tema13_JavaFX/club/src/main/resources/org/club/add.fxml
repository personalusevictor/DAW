<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.club.AddController"
      spacing="0" prefWidth="420" prefHeight="580"
      style="-fx-background-color: #f8f8fc;">

    <HBox style="-fx-background-color: #1a1a2e;" alignment="CENTER_LEFT">
        <padding><Insets top="20" bottom="20" left="24" right="24"/></padding>
        <Button text="&lt; Volver" onAction="#onVolver"
                style="-fx-background-color: transparent; -fx-text-fill: #8888aa;
                       -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 0; -fx-border-color: transparent;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Añadir título"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <VBox spacing="14">
        <padding><Insets top="28" left="28" right="28" bottom="10"/></padding>

        <Label text="Título *" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
        <TextField fx:id="txtTitulo" promptText="Ej: Stranger Things"
                   style="-fx-background-radius: 8; -fx-border-radius: 8;
                          -fx-border-color: #ddd; -fx-padding: 10 12; -fx-font-size: 14px;"/>

        <Label text="Tipo *" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
        <ComboBox fx:id="cmbTipo" promptText="Selecciona..." maxWidth="Infinity"
                  style="-fx-background-radius: 8; -fx-border-radius: 8;
                         -fx-border-color: #ddd; -fx-font-size: 14px;"/>

        <Label text="Duración *" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
        <TextField fx:id="txtDuracion" promptText="Ej: 4 Temporadas / 120 min"
                   style="-fx-background-radius: 8; -fx-border-radius: 8;
                          -fx-border-color: #ddd; -fx-padding: 10 12; -fx-font-size: 14px;"/>

        <HBox spacing="14">
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Año" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                <TextField fx:id="txtAnio" promptText="2024"
                           style="-fx-background-radius: 8; -fx-border-radius: 8;
                                  -fx-border-color: #ddd; -fx-padding: 10 12; -fx-font-size: 14px;"/>
            </VBox>
            <VBox spacing="6" HBox.hgrow="ALWAYS">
                <Label text="Valoración" style="-fx-font-size: 12px; -fx-text-fill: #555; -fx-font-weight: bold;"/>
                <ComboBox fx:id="cmbValoracion" promptText="Estrellas" maxWidth="Infinity"
                          style="-fx-background-radius: 8; -fx-border-radius: 8;
                                 -fx-border-color: #ddd; -fx-font-size: 14px;"/>
            </VBox>
        </HBox>

        <Label fx:id="lblMensaje" text=""
               style="-fx-font-size: 12px;"/>

        <Button text="Guardar" onAction="#onGuardar" maxWidth="Infinity"
                style="-fx-background-color: #534AB7; -fx-text-fill: white;
                       -fx-font-size: 14px; -fx-font-weight: bold;
                       -fx-background-radius: 10; -fx-padding: 13 20; -fx-cursor: hand;
                       -fx-border-color: transparent;"/>
    </VBox>
</VBox>