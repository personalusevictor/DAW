<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="org.club.ListController"
      spacing="0" prefWidth="420" prefHeight="560"
      style="-fx-background-color: #f8f8fc;">

    <HBox style="-fx-background-color: #1a1a2e;" alignment="CENTER_LEFT">
        <padding><Insets top="20" bottom="20" left="24" right="24"/></padding>
        <Button text="&lt; Volver" onAction="#onVolver"
                style="-fx-background-color: transparent; -fx-text-fill: #8888aa;
                       -fx-font-size: 12px; -fx-cursor: hand; -fx-padding: 0; -fx-border-color: transparent;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label text="Mi colección"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: white;"/>
    </HBox>

    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color: transparent; -fx-background: transparent;
                       -fx-border-color: transparent;">
        <VBox fx:id="contenedor" spacing="10">
            <padding><Insets top="20" left="20" right="20" bottom="20"/></padding>
            <Label fx:id="lblVacio"
                   text="Aún no has añadido nada."
                   visible="false"
                   style="-fx-font-size: 13px; -fx-text-fill: #aaa;"/>
        </VBox>
    </ScrollPane>
</VBox>